[gd_resource type="Theme" format=3]

; The menus' look (start menu, pause menu, settings, controls). Set on each menu's root
; Control, not project-wide, so the HUD and the map track's panels keep their own look.
; Colours: deep sea blue panels, white text, the HUD's sky-blue (wind arrow) for sliders and
; the selected tab, and its orange (board triangle) for the keyboard/gamepad focus outline.

[sub_resource type="SystemFont" id="Font_body"]
font_names = PackedStringArray("Fira Sans", "Cantarell", "Noto Sans", "Ubuntu", "Segoe UI", "Helvetica Neue", "DejaVu Sans", "sans-serif")
font_weight = 500

[sub_resource type="SystemFont" id="Font_bold"]
font_names = PackedStringArray("Fira Sans", "Cantarell", "Noto Sans", "Ubuntu", "Segoe UI", "Helvetica Neue", "DejaVu Sans", "sans-serif")
font_weight = 700

[sub_resource type="SystemFont" id="Font_title"]
font_names = PackedStringArray("Fira Sans", "Cantarell", "Noto Sans", "Ubuntu", "Segoe UI", "Helvetica Neue", "DejaVu Sans", "sans-serif")
font_weight = 800

[sub_resource type="SystemFont" id="Font_mono"]
font_names = PackedStringArray("Fira Mono", "DejaVu Sans Mono", "Liberation Mono", "Consolas", "monospace")
font_weight = 700

