[gd_scene format=3]

; Fuerteventura, Sotavento's map (backlog E04.S12; Documentation/reports/spots/sotavento/PLAN.md): the
; terrain drawn from the height grids on the graphics card (HeightTerrain: the near grid at 5 m over
; 12 km with the lagoon and the bar, the far grid at 30 m over 48 km for the Jandia mountains and the
; island on the horizon), the sky and the sun of a July afternoon. The sailing scene sets the
; terrain's water level (the tide).

[ext_resource type="Script" path="res://maps/height_terrain.gd" id="1_terrain"]
[ext_resource type="Texture2D" path="res://maps/sotavento/terrain/near_photo.webp" id="2_near"]
[ext_resource type="Texture2D" path="res://maps/sotavento/terrain/detail_photo.webp" id="3_detail"]
[ext_resource type="Texture2D" path="res://maps/sotavento/terrain/far_photo.webp" id="4_far"]

; The trade wind's sky: a clear deep blue overhead and a pale, hazy horizon (the dust and the sea
; spray the wind carries). The fill light is part sky, part the light the white sand throws back.
[sub_resource type="ProceduralSkyMaterial" id="SkyMaterial_sotavento"]
sky_top_color = Color(0.16, 0.38, 0.72, 1)
sky_horizon_color = Color(0.74, 0.8, 0.86, 1)
sky_curve = 0.1
ground_bottom_color = Color(0.3, 0.42, 0.55, 1)
ground_horizon_color = Color(0.74, 0.8, 0.86, 1)

[sub_resource type="Sky" id="Sky_sotavento"]
sky_material = SubResource("SkyMaterial_sotavento")

[sub_resource type="Environment" id="Environment_sotavento"]
background_mode = 2
sky = SubResource("Sky_sotavento")
ambient_light_source = 3
ambient_light_color = Color(0.7, 0.68, 0.62, 1)
ambient_light_sky_contribution = 0.6
reflected_light_source = 2
tonemap_mode = 2
fog_enabled = true
fog_light_color = Color(0.76, 0.81, 0.87, 1)
fog_sun_scatter = 0.1
fog_density = 4e-05
fog_aerial_perspective = 0.5
fog_sky_affect = 0.0

[node name="Sotavento" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_sotavento")

; Mid-July, 16:00 local time (WEST) at 28.1 N, 14.2 W: the sun in the west-south-west (azimuth 263
; degrees), 62 degrees up. rotation_degrees: (-elevation, 180 - azimuth, 0).
[node name="Sun" type="DirectionalLight3D" parent="."]
rotation_degrees = Vector3(-62, -83, 0)
shadow_enabled = true
directional_shadow_max_distance = 3000.0

[node name="NearTerrain" type="Node3D" parent="."]
script = ExtResource("1_terrain")
heights_json = "res://maps/sotavento/terrain/near_heights.json"
photos_json = "res://maps/sotavento/terrain/photos.json"
photo = ExtResource("2_near")
photo_key = "near"
detail_photo = ExtResource("3_detail")
detail_key = "detail"
chunk_m = 1000.0
levels = Array[Vector2]([Vector2(5, 1500), Vector2(20, 5000), Vector2(100, 0)])
casts_shadows = true
photo_brightness = 0.72

[node name="FarTerrain" type="Node3D" parent="."]
script = ExtResource("1_terrain")
heights_json = "res://maps/sotavento/terrain/far_heights.json"
photos_json = "res://maps/sotavento/terrain/photos.json"
photo = ExtResource("4_far")
photo_key = "far"
hole_heights_json = "res://maps/sotavento/terrain/near_heights.json"
chunk_m = 6000.0
levels = Array[Vector2]([Vector2(30, 15000), Vector2(120, 0)])
casts_shadows = false
photo_brightness = 0.72
