[gd_resource type="Resource" script_class="Spot" load_steps=3 format=3]

; Fuerteventura, Sotavento as a spot (backlog E04.S01 and E04.S12): the PWA World Tour's venue, the
; René Egli Center at Playa Barca. The start is 450 m out from the centre, past the lagoon and the bar,
; in about 6 m of water; the wind is the trade wind from the NNE (cross-offshore from the left); the
; water level is between mean and spring high water, so the lagoon has water, until the tide is
; chosen in the menu (package P4).

[ext_resource type="Script" path="res://maps/spots/spot.gd" id="1"]
[ext_resource type="Resource" path="res://maps/sotavento/map_config.tres" id="2"]

