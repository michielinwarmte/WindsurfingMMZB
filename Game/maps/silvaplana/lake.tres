[gd_resource type="ShaderMaterial" load_steps=4 format=3]

; Lake Silvaplana's water look (MAP_SILVAPLANA_PLAN.md, M2), for res://maps/lake.gdshader: water
; you can see into, darker and bluer with depth. The water itself is the teal blue of the 2025
; aerial photo. The ripples drift toward the east-north-east, downwind of the Maloja (from 244).

[ext_resource type="Shader" path="res://maps/lake.gdshader" id="1_lake"]

[sub_resource type="FastNoiseLite" id="Noise_ripples"]
noise_type = 3
frequency = 0.02
fractal_octaves = 3

[sub_resource type="NoiseTexture2D" id="Texture_ripples"]
seamless = true
as_normal_map = true
bump_strength = 6.0
noise = SubResource("Noise_ripples")

[resource]
; Drawn before other see-through things (the sail): a big water plane sorted after the sail would
; paint over it, because see-through surfaces don't block what comes after them.
render_priority = -1
shader = ExtResource("1_lake")
shader_parameter/ripple_normals = SubResource("Texture_ripples")
shader_parameter/absorption_per_m = Vector3(0.4, 0.1, 0.08)
shader_parameter/deep_color = Color(0.05, 0.22, 0.28, 1)
shader_parameter/ripple_drift_direction = Vector2(0.9, -0.44)
