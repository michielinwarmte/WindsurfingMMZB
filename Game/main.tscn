; The open sea's light and air: the same sky and sun as the Silvaplana map (a clear summer
; afternoon, around 15:00; main.gd turns the sun), so the two scenes feel like the same game.
; The fill light is 75 % the sky and 25 % a neutral grey (all sky made the sail too blue). The
; haze of a summer afternoon: you see about 20 km (fog density 0.0002 per metre: 18 % haze at
; 1 km, 63 % at the horizon 5 km away), half in the colour of the sky behind it
; (aerial perspective), so the sea fades into a pale horizon. The sky itself is not fogged.
[sub_resource type="ProceduralSkyMaterial" id="SkyMaterial_main"]
sky_top_color = Color(0.12, 0.32, 0.7, 1)
sky_horizon_color = Color(0.62, 0.74, 0.88, 1)
sky_curve = 0.12
ground_bottom_color = Color(0.06, 0.2, 0.33, 1)
ground_horizon_color = Color(0.62, 0.74, 0.88, 1)
ground_curve = 0.3

[sub_resource type="Sky" id="Sky_main"]
sky_material = SubResource("SkyMaterial_main")

[sub_resource type="Environment" id="Environment_main"]
background_mode = 2
sky = SubResource("Sky_main")
ambient_light_source = 3
ambient_light_color = Color(0.62, 0.64, 0.66, 1)
ambient_light_sky_contribution = 0.75
reflected_light_source = 2
tonemap_mode = 2
fog_enabled = true
fog_light_color = Color(0.62, 0.74, 0.88, 1)
fog_sun_scatter = 0.1
fog_density = 0.0002
fog_aerial_perspective = 0.5
fog_sky_affect = 0.0

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_main")

[node name="Sun" type="DirectionalLight3D" parent="."]
shadow_enabled = true

[node name="Ocean" type="Node3D" parent="."]
script = ExtResource("5_ocean")

[node name="Windsurfer" parent="." instance=ExtResource("2_windsurfer")]

